<idea-plugin>
    <id>dev.katherine.consilium</id>
    <name>Consilium</name>
    <vendor>Katherine Mironova</vendor>

    <!-- The description, version and change notes are set by build.gradle.kts at build time. -->

    <depends>com.intellij.modules.platform</depends>
    <dependencies>
        <!-- MarkdownText sanitizes answers with the platform's bundled jsoup. -->
        <module name="intellij.libraries.jsoup"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="Consilium"
                anchor="right"
                secondary="true"
                factoryClass="dev.katherine.consilium.ConsiliumToolWindowFactory"
                icon="/icons/consilium.svg"/>
    </extensions>
</idea-plugin>
